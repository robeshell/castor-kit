{
  "name": "castorjs",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @castorjs/api --filter @castorjs/web dev",
    "dev:api": "pnpm --filter @castorjs/api dev",
    "dev:web": "pnpm --filter @castorjs/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @castorjs/api db:generate",
    "db:migrate": "pnpm --filter @castorjs/api db:migrate",
    "seed:rbac": "pnpm --filter @castorjs/api seed:rbac",
    "seed:demo": "pnpm --filter @castorjs/api seed:demo",
    "setup-once": "pnpm --filter @castorjs/api setup-once",
    "openapi:generate": "pnpm --filter @castorjs/api openapi:generate",
    "openapi:apifox": "pnpm --filter @castorjs/api openapi:apifox",
    "scaffold": "pnpm --filter @castorjs/api scaffold",
    "verify": "pnpm --filter @castorjs/api verify",
    "mcp": "pnpm --filter @castorjs/mcp start",
    "lint": "pnpm --filter @castorjs/api --filter @castorjs/web lint",
    "demo:reset": "pnpm --filter @castorjs/api demo:reset"
  }
}
