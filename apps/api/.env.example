# Copy to .env.development / .env.production (both are gitignored)

# NODE_ENV=development
DEV_DATABASE_URL=postgresql://localhost/castor_kit
# DATABASE_URL=postgresql://user:pass@host/castor_kit      # production
# TEST_DATABASE_URL=postgresql://localhost/castor_kit_test  # vitest

# Required in production (the server refuses to start without them)
# SECRET_KEY=
# ADMIN_PASSWORD=

# PORT=5001

# Scheduled tasks: the web process does not start the scheduler by default; enable it explicitly to fire tasks on cron locally (or run `pnpm worker` separately)
# RUN_SCHEDULER_IN_WEB=true

# ── Mail, file storage, uploads, AI model, site URL, sign-in lockout ──
# Configure these on the System settings page (系统设置); secrets are stored encrypted with SECRET_KEY.
# A variable set here pins the value instead (the page shows it read-only). Leave them unset to use the page.
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# APP_BASE_URL=http://localhost:5173
# SMTP_HOST= / SMTP_PORT=587 / SMTP_SECURE= / SMTP_USER= / SMTP_PASSWORD= / MAIL_FROM=
# STORAGE_DRIVER=local / S3_ENDPOINT= / S3_REGION= / S3_BUCKET= / S3_ACCESS_KEY= / S3_SECRET_KEY= / S3_PUBLIC_URL= / S3_FORCE_PATH_STYLE=
# UPLOAD_MAX_SIZE=10485760 / UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,webp,pdf,txt,csv,doc,docx,xls,xlsx,ppt,pptx,zip
# LOGIN_MAX_FAILURES=10 / LOGIN_LOCKOUT_MINUTES=15

# Development: print mails to this log instead of sending them (none = never send)
# MAIL_DRIVER=log

# ── Server ────────────────────────────────────────────────────────────
# SESSION_TTL_HOURS=8        (default of the session lifetime setting)
# CORS_ORIGINS=
# Per-IP request limits (the numbers are in System settings; counted per process). false turns them off
# RATE_LIMIT_ENABLED=true
# MAX_CONTENT_LENGTH=16777216
# WEB_DIST_DIR=../web/dist
# Directory of the local file storage driver
# STORAGE_LOCAL_DIR=instance/uploads/files

# Public demo: system management read-only, demo account on the login page, sample data restored every DEMO_RESET_HOURS
# (restoring replaces the component gallery data, so don't enable it against a database you care about)
# DEMO_MODE=true
# DEMO_RESET_HOURS=24
# Demo AI quota: calls per IP per hour, calls per day for the whole site, max request size (characters)
# DEMO_AI_HOURLY_PER_IP=20
# DEMO_AI_DAILY=300
# DEMO_AI_MAX_INPUT_CHARS=4000
