# 复制为 .env.development / .env.production（已被 .gitignore 忽略）

# NODE_ENV=development
DEV_DATABASE_URL=postgresql://localhost/castor_kit
# DATABASE_URL=postgresql://user:pass@host/castor_kit      # production
# TEST_DATABASE_URL=postgresql://localhost/castor_kit_test  # vitest

# production 必填（缺失即拒绝启动）
# SECRET_KEY=
# ADMIN_PASSWORD=

# PORT=5001

# 定时任务：web 进程默认不启动调度器，本地要让任务按 cron 触发需显式打开（或另起 `pnpm worker`）
# RUN_SCHEDULER_IN_WEB=true

# AI 对话 / AI 数据查询 / 提示词预览：未配置时页面提示“未配置”。
# 按需填写（OpenAI 兼容接口）
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# SESSION_TTL_HOURS=8
# CORS_ORIGINS=
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MINUTES=15
# MAX_CONTENT_LENGTH=16777216
# WEB_DIST_DIR=../web/dist
