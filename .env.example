# ============================================================
# castor-kit environment variables (example)
# Copy this file to .env.development or .env.production and fill in real values
# Note: .env.development / .env.production are gitignored; never commit real secrets
# ============================================================

# ── Runtime ───────────────────────────────────────────────────────────
# Allowed values: development | production | test
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────────
# Long random string; must be replaced in production
SECRET_KEY=

# ── Database ─────────────────────────────────────────────────────────
# Development (read when NODE_ENV=development)
DEV_DATABASE_URL=

# Production (read when NODE_ENV=production)
DATABASE_URL=

# ── Admin account ─────────────────────────────────────────────────────
# Used when pnpm seed:rbac initializes the data
ADMIN_PASSWORD=

# ── AI (OpenAI-compatible) ────────────────────────────────────────────
# The AI chat page (ai_chat) and the AI SQL page (ai_sql) share these three variables
# AI_API_KEY    Required: your API key
# AI_API_BASE   API base URL; any OpenAI-compatible endpoint works (e.g. https://api.openai.com/v1)
# AI_MODEL      Model name, e.g. gpt-4o, claude-3-5-sonnet
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

# ── Scheduled task runner ─────────────────────────────────────────────
# ENABLE_TASK_SCHEDULER            Enable background scheduled tasks, true/false
# TASK_SCHEDULER_INTERVAL_SECONDS  Scan interval (seconds), default 20
# TASK_SCHEDULER_LEASE_SECONDS     Task lock lease (seconds) to prevent duplicate runs, default 1800
# RUN_SCHEDULER_IN_WEB             Run the scheduler inside the web process (false recommended for multi-process deployments)
ENABLE_TASK_SCHEDULER=
TASK_SCHEDULER_INTERVAL_SECONDS=
TASK_SCHEDULER_LEASE_SECONDS=
RUN_SCHEDULER_IN_WEB=

# ── Apifox doc sync (optional, only used by pnpm openapi:apifox) ───
APIFOX_PROJECT_ID=
APIFOX_ACCESS_TOKEN=
APIFOX_API_VERSION=

# ── AI SQL read-only account (required for production compose) ──────
# POSTGRES_RO_PASSWORD  Password of the read-only account; setup-once uses it to create
#                       castor_kit_ro in the DB (non-superuser, SELECT on business tables only).
#                       setup.sh generates a random value automatically.
# AI_SQL_DATABASE_URL   Read-only connection string; production compose builds it as
#                       postgresql://castor_kit_ro:<POSTGRES_RO_PASSWORD>@db/castor_kit,
#                       so it rarely needs to be set by hand.
# AI_SQL_STATEMENT_TIMEOUT_MS  Per-statement timeout for AI SQL (ms), default 5000
POSTGRES_RO_PASSWORD=
AI_SQL_DATABASE_URL=
AI_SQL_STATEMENT_TIMEOUT_MS=5000

# ── Session security ───────────────────────────────────────────────
# SESSION_COOKIE_SECURE   true/false/empty=auto (auto sets the Secure cookie flag only over HTTPS)
# SESSION_TTL_HOURS       Session lifetime (hours), default 8
SESSION_COOKIE_SECURE=
SESSION_TTL_HOURS=8
