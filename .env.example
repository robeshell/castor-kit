# ============================================================
# castor-kit 环境变量示例
# 复制此文件为 .env.development 或 .env.production 后填写真实值
# 注意：.env.development / .env.production 已加入 .gitignore，请勿提交真实密钥
# ============================================================

# ── 运行环境 ──────────────────────────────────────────────────────────
# 可选值: development | production | test
NODE_ENV=development

# ── 安全 ─────────────────────────────────────────────────────────────
# 随机长字符串，生产环境务必替换
SECRET_KEY=

# ── 数据库 ───────────────────────────────────────────────────────────
# 开发环境（NODE_ENV=development 时读取）
DEV_DATABASE_URL=

# 生产环境（NODE_ENV=production 时读取）
DATABASE_URL=

# ── 管理员账号 ────────────────────────────────────────────────────────
# pnpm seed:rbac 初始化时使用
ADMIN_PASSWORD=

# ── AI (OpenAI-compatible) ────────────────────────────────────────────
# AI 对话页 (ai_chat) 和 AI SQL 页 (ai_sql) 共用以下三个变量
# AI_API_KEY    必填，填入你的 API Key
# AI_API_BASE   接口地址，支持任何 OpenAI 兼容接口（如 https://api.openai.com/v1）
# AI_MODEL      模型名称，如 gpt-4o、claude-3-5-sonnet 等
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

# ── 定时任务调度 ──────────────────────────────────────────────────────
# ENABLE_TASK_SCHEDULER            是否启用后台定时任务，true/false
# TASK_SCHEDULER_INTERVAL_SECONDS  扫描间隔（秒），默认 20
# TASK_SCHEDULER_LEASE_SECONDS     任务锁租约（秒），防止重复执行，默认 1800
# RUN_SCHEDULER_IN_WEB             是否在 Web 进程中运行调度器（多进程部署时建议 false）
ENABLE_TASK_SCHEDULER=
TASK_SCHEDULER_INTERVAL_SECONDS=
TASK_SCHEDULER_LEASE_SECONDS=
RUN_SCHEDULER_IN_WEB=

# ── Apifox 文档同步（可选，仅 pnpm openapi:apifox 使用）────
APIFOX_PROJECT_ID=
APIFOX_ACCESS_TOKEN=
APIFOX_API_VERSION=

# ── AI SQL 只读账号（生产 compose 必填）─────────────────────────────
# POSTGRES_RO_PASSWORD  只读账号密码，setup-once 会用它在 DB 里创建
#                       castor_kit_ro（非超级用户，仅业务表 SELECT）。
#                       setup.sh 会自动生成随机值。
# AI_SQL_DATABASE_URL   只读连接串，生产 compose 自动拼接为
#                       postgresql://castor_kit_ro:<POSTGRES_RO_PASSWORD>@db/castor_kit，
#                       通常无需手工填写。
# AI_SQL_STATEMENT_TIMEOUT_MS  AI SQL 单条语句超时（毫秒），默认 5000
POSTGRES_RO_PASSWORD=
AI_SQL_DATABASE_URL=
AI_SQL_STATEMENT_TIMEOUT_MS=5000

# ── 会话安全 ───────────────────────────────────────────────────────
# SESSION_COOKIE_SECURE   true/false/留空=auto（auto 仅在 HTTPS 下给 Cookie 打 Secure 标志）
# SESSION_TTL_HOURS       会话有效期（小时），默认 8
SESSION_COOKIE_SECURE=
SESSION_TTL_HOURS=8
